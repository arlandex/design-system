{
    "name": "Nataliya's Style Guide",
    "version": "v13",
    "releaseDate": "2026-09-03",
    "color": {
          "milkFrost": "#F0EFEC",
          "softIvory": "#EAE1D7",
          "paleSand": "#D8C9B6",
          "fogStone": "#6C6D6C",
          "bodyInk": {
                  "value": "#48494B",
                  "note": "Default-palette reading tone for long-form body copy; functional neutral, not an accent."
          },
          "ink": "#0D1015"
    },
    "contextualMineralColor": {
          "mineralFrost": "#F2F5F4",
          "paleMineral": "#E3E9E7",
          "seaGlass": "#C6D1CE",
          "mineralStone": "#63716D",
          "bodyInk": {
                  "value": "#414C48",
                  "note": "Contextual Mineral reading tone for long-form body copy; functional neutral, not an accent."
          },
          "ink": "#0D1512",
          "usage": "Reserved for specific information-architecture HTML pages."
    },
    "wireframingCoolGreyColor": {
          "frost": "#F4F5F6",
          "softGrey": "#E6E8EA",
          "paleSteel": "#CDD1D4",
          "steelStone": "#686D72",
          "bodyInk": {
                  "value": "#464B50",
                  "note": "Cool Grey reading tone; functional neutral, not an accent."
          },
          "ink": "#101419",
          "usage": "Wireframing only."
    },
    "roles": {
          "field": { "swatches": ["milkFrost", "softIvory"], "note": "Gradient ground; the two lightest swatches." },
          "guideLayer": { "swatches": ["paleSand"], "note": "Bounds arrows, axis, diagonal ticks." },
          "structure": { "swatches": ["fogStone"], "note": "Connector line, hub stroke, measurement text." },
          "readingTone": { "swatches": ["bodyInk"], "note": "Long-form body copy; functional neutral, not an accent." },
          "clusterSatellites": { "swatches": ["paleSand", "fogStone"], "fogStoneStyle": "outline", "note": "Mixed solid-and-outline dots; no Ink." },
          "focalPoint": { "swatches": ["ink"], "note": "Darkest, coldest; appears nowhere else." },
          "typeInDiagram": { "data": "fogStone", "labels": "ink" },
          "accent": { "swatch": "ink", "uses": ["node", "emphasis", "tag", "underline", "iconStroke"], "rule": "Boldest thing in view, used sparingly, never as a background." },
          "informationArchitecture": {
                  "default": { "raisedSurface": "softIvory", "border": "paleSand", "structuralControl": "bodyInk", "structuralSecondary": "fogStone", "primary": "ink" },
                  "mineral": { "canvas": "mineralFrost", "surface": "paleMineral", "border": "seaGlass", "structuralControl": "bodyInk", "structuralSecondary": "mineralStone", "primary": "ink" },
                  "rule": "Structural controls communicate hierarchy and navigation. They are not focal accents. No white surface token is approved.",
                  "validatedSource": "C2 Product Anatomy V8"
          }
    },
    "typography": {
          "fontFamilies": {
                  "sans": "Source Sans 3",
                  "mono": "IBM Plex Mono"
          },
          "eyebrow": { "displayName": "Context label", "note": "Small uppercase line above a title; also known as an eyebrow.", "font": "mono", "weight": 500, "size": "11.5px", "tracking": "0.14em", "color": "fogStone" },
          "h1": { "font": "sans", "weight": 700, "size": "clamp(24px, 4vw, 30px)", "color": "ink" },
          "h2": { "font": "sans", "weight": 600, "size": "18.5px", "color": "fogStone" },
          "body": { "font": "sans", "weight": 400, "size": "15.5px", "lineHeight": 1.4, "color": "bodyInk", "maxMeasure": "100%" },
          "compactBody": { "font": "sans", "weight": 400, "size": "13.5px", "lineHeight": 1.4, "color": "bodyInk" },
          "informationArchitecture": {
                  "level1": { "font": "sans", "weight": 700, "size": "20px", "color": "ink" },
                  "level2": { "font": "sans", "weight": 700, "size": "16.5px", "color": "ink" },
                  "level3": { "font": "sans", "weight": 700, "size": "14.5px", "color": "ink" },
                  "codeMetadata": { "font": "mono", "weight": 500, "size": "10.5px", "color": "structuralSecondary", "usage": "codes and descriptors" },
                  "subcardMetadata": { "font": "mono", "weight": 500, "size": "9.5px", "color": "structuralSecondary" }
          }
    },
    "components": {
          "sectionHeader": { "border": "bodyInk", "rule": "Use Body Ink, never primary Ink, for every section-header border." },
          "radii": { "tag": "4px", "control": "8px", "primaryLevelMarker": "9px", "innerCard": "10px", "outerCard": "12px" },
          "hierarchyMarkers": {
                  "primary": { "size": "42px", "typeSize": "17px", "radius": "9px" },
                  "secondary": { "size": "36px", "typeSize": "10.5px", "radius": "8px" },
                  "rule": "Use the primary dimensions for Level 1 and the secondary dimensions for Level 2 markers."
          },
          "elevation": {
                  "raised": "0 1px 2px rgba(13,16,21,.04), 0 6px 16px -8px rgba(13,16,21,.10)",
                  "raisedMineral": "0 1px 2px rgba(13,21,18,.04), 0 6px 16px -8px rgba(13,21,18,.10)",
                  "rule": "Use on bounded interactive or nested cards, never as decoration alone."
          },
          "interaction": { "focusRing": "2px", "focusOffset": "2px", "editFocusOffset": "3px", "editFocusRadius": "3px", "disclosureMotion": "150ms", "reducedMotion": true, "rule": "Use the standard focus geometry for navigation controls and the edit-focus geometry for editable text fields." },
          "wideCanvas": {
                  "minWidth": "1280px",
                  "smallViewport": "horizontal scroll",
                  "pageInsets": { "top": "40px", "sides": "48px", "bottom": "64px" },
                  "primaryGap": "22px",
                  "nestedGap": "16px",
                  "requirements": ["keep global controls visible", "show an overflow cue", "preserve hierarchy"],
                  "rule": "Use these measurements for wide information-architecture canvases instead of the default page spacing rules."
          }
    },
    "spacing": {
          "tight": { "px": 8, "usage": "Icon/label gaps, swatch-pill spacing, tag internals" },
          "compact": { "px": 16, "usage": "Grid gaps, swatch/accent cell padding, spec-row gaps" },
          "standard": { "px": 24, "usage": "Element-row padding, section notes, accent-cell padding" },
          "comfortable": { "px": 32, "usage": "Default page side margin, padding-scale strip padding" },
          "rhythm": { "px": 48, "usage": "Type-card internal padding" },
          "section": { "px": 64, "usage": "Space between major sections, default page top padding" },
          "page": { "px": 96, "usage": "Default page bottom padding, page close" }
    },
    "provenance": {
          "moodboard": "iPhone backgrounds (Pinterest)",
          "note": "As of v4, Ink (#0D1015, cool near-black) replaced the original warm 'Urban Espresso' as the focal-point accent.",
          "designReference": "Taplio's blog"
    }
}
